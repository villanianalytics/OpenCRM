# Copy this file to .env. Never commit the populated file.
APP_ENV=production
APP_URL=https://crm.example.com
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=replace-with-64-random-hex-characters
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=opencrm
DB_USER=your_database_user
DB_PASS=use-a-strong-database-password
ADMIN_USERNAME=choose-an-admin-username
ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
ADMIN_EMAIL=admin@example.com
# Set false only for local HTTP development.
SESSION_SECURE=true
UPLOAD_MAX_MB=12
APP_TIMEZONE=America/New_York
